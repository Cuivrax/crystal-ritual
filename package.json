{
  "name": "crystal-ritual",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Crystal & Ritual, static site for crystalandritual.com",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "gate": "node scripts/gate-report.mjs",
    "build": "node scripts/gate-report.mjs && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:launch": "BUILD_NOW=2026-12-06T07:00 npm run build",
    "build:preview": "PREVIEW=1 npm run build",
    "dev": "PREVIEW=1 astro dev",
    "preview": "astro preview",
    "test": "node --test tests/*.test.mjs",
    "check:links": "node scripts/check-links.mjs dist",
    "photos": "node scripts/fetch-photos.mjs",
    "shots": "node scripts/screenshots.cjs"
  },
  "dependencies": {
    "@fontsource/figtree": "5.3.0",
    "@fontsource/gilda-display": "5.3.0",
    "astro": "7.4.13",
    "hast-util-to-html": "9.0.6",
    "hast-util-to-string": "3.0.1",
    "hastscript": "9.0.3",
    "mdast-util-to-string": "4.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sharp": "0.35.5",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "yaml": "2.9.1"
  }
}
