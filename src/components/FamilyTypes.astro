---
// "All Types of Jade", the family hub section of a head stone page (see lib/families.mjs).
// Varieties whose page is published get the full Stone Atlas card with its link. The others
// follow as a compact list of name tiles under "Coming Next", each with Full Guide Coming,
// A to Z. A variety moves up to a full card when its page passes the publish gate. No script.
import { cardAssets, stoneCard, cardArticle } from '../lib/stone-cards.mjs';
import { orderCards, fallbackName, comingTileHtml, FAMILY_ID, FAMILY_INTRO, FAMILY_COMING } from '../lib/families.mjs';
const { family, site, band = 'band-soft' } = Astro.props;
const assets = await cardAssets(site);
const cards = orderCards(family.varieties.map((slug) => stoneCard(slug, assets, { fallbackName: fallbackName(slug, family.planNames) })));
const live = cards.filter((c) => c.guide);
const coming = cards.filter((c) => !c.guide);
---
<section class={['section', 'family-types', band].join(' ')} aria-labelledby={FAMILY_ID}>
  <div class="wrap">
    <h2 class="section-title" id={FAMILY_ID}>{family.heading}</h2>
    <p class="family-intro">{FAMILY_INTRO}</p>
    {live.length > 0 && <div class="atlas-grid family-grid" set:html={live.map(cardArticle).join('')} />}
    {coming.length > 0 && (
      <Fragment>
        <h3 class="family-coming-title">{FAMILY_COMING}</h3>
        <ul class="family-coming" set:html={coming.map(comingTileHtml).join('')} />
      </Fragment>
    )}
  </div>
</section>
