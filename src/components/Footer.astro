---
import { FOOTER_NAV, SITE_NAME, TAGLINE, DISCLAIMER, pathOf } from '../lib/nav.mjs';
import { getSite } from '../lib/site.mjs';
const site = await getSite();
const cols = FOOTER_NAV.map((c) => ({ title: c.title, items: c.items.filter((n) => site.isBuilt(pathOf(n.href))) })).filter((c) => c.items.length);
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <p class="name">{SITE_NAME}</p>
        <p>{TAGLINE}</p>
      </div>
      <nav class="footer-cols" aria-label="Footer">
        {cols.map((c) => <div class="footer-col"><p class="footer-col-title">{c.title}</p><ul role="list">{c.items.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul></div>)}
      </nav>
    </div>
    <p class="footer-note">{DISCLAIMER}</p>
  </div>
</footer>
