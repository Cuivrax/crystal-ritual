---
import Body from './Body.astro';
import { badge } from '../lib/ui.mjs';
const { sections = [], page, skip = [], plainBands = false, fold = [] } = Astro.props;
const CHEV = '<svg class="fold-chev" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>';
const list = sections.filter((s) => !skip.includes(s.kind));
---
{list.map((s) => (
  <section class={['section', `kind-${s.kind}`, plainBands ? '' : s.band].filter(Boolean).join(' ')} aria-labelledby={s.id}>
    <div class="wrap">
      {fold.includes(s.kind) ? (
        <details class="fold sec-fold">
          <summary><h2 class="section-title" id={s.id} set:html={s.headingHtml} /><Fragment set:html={CHEV} /></summary>
          <div class="prose"><Body html={s.html} page={page} /></div>
          {s.extraHtml && <Fragment set:html={s.extraHtml} />}
        </details>
      ) : s.layout === 'price' ? (
        <div class="price-row">
          <div class="card">
            <h2 class="section-title" id={s.id} set:html={s.headingHtml} />
            <div class="prose"><Body html={s.html} page={page} /></div>
          </div>
          {s.extraHtml && <Fragment set:html={s.extraHtml} />}
        </div>
      ) : (
        <Fragment>
          {s.badge && <p class="section-badge" set:html={badge(s.badge)} />}
          <h2 class="section-title" id={s.id} set:html={s.headingHtml} />
          {s.layout === 'what' ? (
            <Fragment>
              <div class={['what-top', s.asideHtml ? 'split' : ''].filter(Boolean).join(' ')}>
                <div class="prose"><Body html={s.html} page={page} /></div>
                {s.asideHtml && <aside class="side key-numbers" set:html={s.asideHtml} />}
              </div>
              {s.chainHtml && <Fragment set:html={s.chainHtml} />}
              {s.bodyHtml && (
                <div class={['what-body', s.bodyAsideHtml ? 'split' : ''].filter(Boolean).join(' ')}>
                  <div class="prose"><Body html={s.bodyHtml} page={page} /></div>
                  {s.bodyAsideHtml && <aside class="side what-aside" set:html={s.bodyAsideHtml} />}
                </div>
              )}
              {s.tailHtml && <div class="prose layout-facts what-tail"><Body html={s.tailHtml} page={page} /></div>}
            </Fragment>
          ) : s.layout === 'split' && s.asideHtml ? (
            <div class="split">
              <div class="prose"><Body html={s.html} page={page} /></div>
              <aside class="side" set:html={s.asideHtml} />
            </div>
          ) : (
            <div class={['prose', s.layout ? `layout-${s.layout}` : ''].filter(Boolean).join(' ')}><Body html={s.html} page={page} /></div>
          )}
        </Fragment>
      )}
    </div>
  </section>
))}
