---
const { items = [] } = Astro.props;
---
{items.length > 1 && (
  <nav class="breadcrumb" aria-label="Breadcrumb">
    {items.map((b, i) => (
      <Fragment>
        {i > 0 && <span aria-hidden="true">/</span>}
        {i === items.length - 1 ? <span aria-current="page">{b.name}</span> : b.url ? <a href={b.url}>{b.name}</a> : <span>{b.name}</span>}
      </Fragment>
    ))}
  </nav>
)}
