---
// The trail is an ordered list, the order is the hierarchy. The slashes are drawn by CSS, so they are never read aloud.
const { items = [] } = Astro.props;
---
{items.length > 1 && (
  <nav class="breadcrumb" aria-label="Breadcrumbs">
    <ol role="list">
      {items.map((b, i) => (
        <li>{i === items.length - 1 ? <span aria-current="page">{b.name}</span> : b.url ? <a href={b.url}>{b.name}</a> : <span>{b.name}</span>}</li>
      ))}
    </ol>
  </nav>
)}
