---
// The Stone Atlas, an A to Z grid of every stone sheet, with client-side filters by name
// or label, color, intention (intent_rankings.json), hardness and Full Guides Only.
// A stone whose page is published gets the full card with its link. Any other stone gets
// a light card with no link, its swatches, its Mohs range and one short verified fact from
// its sheet (scripts/build-stone-extras.mjs), and a photo only when a checked one exists.
// A page that passes the publish gate later switches to the full card on the next build.
// The cards are built in lib/stone-cards.mjs, shared with the family sections of head stone pages.
import { getSite } from '../../lib/site.mjs';
import { stonesIndex, intents } from '../../lib/render.mjs';
import { cardAssets, stoneCard, cardClass, fullCardHtml, miniCardHtml } from '../../lib/stone-cards.mjs';
import { COLOR_FAMILIES, COLOR_LABELS } from '../../lib/colors.mjs';
import { INTENTIONS } from '../../lib/ui.mjs';
const site = await getSite();
const assets = await cardAssets(site);
const hardBucket = (m) => (!m ? '' : m.max < 5 ? 'soft' : m.min >= 7 ? 'hard' : 'medium');
const intsOf = (slug) => Object.entries(intents).filter(([, list]) => (list.find((r) => r.slug === slug)?.facets || 0) >= 3).map(([k]) => k);
const searchOf = (name, aliases) => [name, ...(aliases || []).map((a) => String(a).replace(/\s*\([^)]*\)/g, ''))].join(' | ').toLowerCase();

const slugs = new Set([...Object.keys(stonesIndex.stones), ...assets.built.keys()]);
const cards = [...slugs].map((slug) => {
  const c = stoneCard(slug, assets);
  return { ...c, ints: intsOf(slug), colors: c.sheet?.colorFamilies || [], hard: hardBucket(c.sheet?.mohs), search: searchOf(c.name, c.sheet?.aliases) };
}).sort((a, b) => a.name.localeCompare(b.name));
const guides = cards.filter((c) => c.guide).length;
const colorOpts = COLOR_FAMILIES.filter((c) => cards.some((x) => x.colors.includes(c)));
const intentOpts = Object.keys(INTENTIONS).filter((k) => cards.some((x) => x.ints.includes(k)));
const hardOpts = [['soft', 'Soft, Under 5'], ['medium', 'Medium, 5 to 6.5'], ['hard', 'Hard, 7 and Up']].filter(([k]) => cards.some((x) => x.hard === k));
const countText = (n, g) => `${n} ${n === 1 ? 'stone' : 'stones'}, ${g} with a full guide`;
let lastLetter = '';
---
<section class="atlas" id="atlas" aria-label="The Stone Atlas">
  <form class="atlas-filters" role="search" aria-label="Filter the Stone Atlas" action="/stones/" method="get">
    <div class="field"><label for="atlas-q">Name or Label</label><input id="atlas-q" name="q" type="search" placeholder="Search a stone, or the name on a label" autocomplete="off"></div>
    <div class="field"><label for="atlas-color">Color</label><select id="atlas-color" name="color"><option value="">Any Color</option>{colorOpts.map((c) => <option value={c}>{COLOR_LABELS[c]}</option>)}</select></div>
    <div class="field"><label for="atlas-intention">Intention</label><select id="atlas-intention" name="intention"><option value="">Any Intention</option>{intentOpts.map((k) => <option value={k}>{INTENTIONS[k].label}</option>)}</select></div>
    <div class="field"><label for="atlas-hardness">Hardness</label><select id="atlas-hardness" name="hardness"><option value="">Any Hardness</option>{hardOpts.map(([k, l]) => <option value={k}>{l}</option>)}</select></div>
    <label class="atlas-toggle"><input type="checkbox" name="guides" value="1"> Full Guides Only</label>
  </form>
  <p class="atlas-count" id="atlas-count" aria-live="polite">{countText(cards.length, guides)}</p>
  <div class="atlas-grid">
    {cards.map((c) => {
      const letter = c.name.charAt(0).toUpperCase();
      const head = letter !== lastLetter;
      lastLetter = letter;
      return (
        <Fragment>
          {head && <p class="atlas-letter" data-letter={letter}>{letter}</p>}
          {c.guide
            ? <article class={cardClass(c)} data-letter={letter} data-search={c.search} data-colors={c.colors.join(' ')} data-ints={c.ints.join(' ')} data-hard={c.hard} data-guide="1" set:html={fullCardHtml(c)} />
            : <article class={cardClass(c)} data-letter={letter} data-search={c.search} data-colors={c.colors.join(' ')} data-ints={c.ints.join(' ')} data-hard={c.hard} set:html={miniCardHtml(c)} />}
        </Fragment>
      );
    })}
  </div>
  <p class="atlas-none" id="atlas-none" hidden>No stone matches. Try another name or fewer filters.</p>
  <p class="atlas-note">Intentions are beliefs, rated on our five-facet scale. A stone is listed under an intention from Often Linked up. Stones marked Full Guide Coming get their own page soon.</p>
</section>
<script>
  const form = document.querySelector('.atlas-filters');
  const cards = [...document.querySelectorAll('.atlas-card')];
  const letters = [...document.querySelectorAll('.atlas-letter')];
  const count = document.getElementById('atlas-count');
  const none = document.getElementById('atlas-none');
  const norm = (s) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/['’]/g, '').trim();
  const params = new URLSearchParams(location.search);
  for (const k of ['q', 'color', 'intention', 'hardness']) {
    const el = form.elements[k];
    if (el && params.get(k)) el.value = params.get(k);
  }
  if (params.get('guides') === '1') form.elements.guides.checked = true;
  function apply() {
    const q = norm(form.elements.q.value || '');
    const color = form.elements.color.value;
    const intention = form.elements.intention.value;
    const hard = form.elements.hardness.value;
    const guidesOnly = form.elements.guides.checked;
    let n = 0;
    let g = 0;
    const seen = new Set();
    for (const c of cards) {
      const ok = (!q || norm(c.dataset.search).includes(q))
        && (!color || c.dataset.colors.split(' ').includes(color))
        && (!intention || c.dataset.ints.split(' ').includes(intention))
        && (!hard || c.dataset.hard === hard)
        && (!guidesOnly || c.dataset.guide === '1');
      c.hidden = !ok;
      if (ok) { n++; if (c.dataset.guide === '1') g++; seen.add(c.dataset.letter); }
    }
    for (const l of letters) l.hidden = !seen.has(l.dataset.letter);
    count.textContent = `${n} ${n === 1 ? 'stone' : 'stones'}, ${g} with a full guide`;
    none.hidden = n > 0;
    try {
      const p = new URLSearchParams();
      for (const k of ['q', 'color', 'intention', 'hardness']) if (form.elements[k].value) p.set(k, form.elements[k].value);
      if (guidesOnly) p.set('guides', '1');
      const qs = p.toString();
      history.replaceState(null, '', location.pathname + (qs ? `?${qs}` : '') + location.hash);
    } catch (e) { /* ignore */ }
  }
  form.addEventListener('input', apply);
  form.addEventListener('change', apply);
  form.addEventListener('submit', (e) => { e.preventDefault(); apply(); });
  apply();
</script>
