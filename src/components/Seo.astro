---
import { absoluteUrl } from '../lib/urls.mjs';
import { jsonLd } from '../lib/seo.mjs';
import { SITE_NAME } from '../lib/nav.mjs';
const { page = null, title, description, url, image = null, breadcrumbs = [], citations = [], noindex = false, authorUrl = null, errorPage = false } = Astro.props;
// The 404 page answers at any address, so it gets no canonical, no og:url and no structured data.
const canonical = errorPage ? null : absoluteUrl(url);
const isArticle = page && !['home', 'hub', 'directory', 'trust', 'tool', 'color', 'chakra'].includes(page.type);
// Pages without a photo share the brand card, so links on Pinterest, Facebook and Threads always show an image.
const shareImage = image || absoluteUrl('/og-default.jpg');
const ld = errorPage ? null : jsonLd({ page, title, description, url, image, breadcrumbs, citations, authorUrl });
---
<title>{title}</title>
<meta name="description" content={description}>
{canonical && <link rel="canonical" href={canonical}>}
{noindex && <meta name="robots" content="noindex, nofollow">}
<meta property="og:type" content={isArticle ? 'article' : 'website'}>
<meta property="og:site_name" content={SITE_NAME}>
<meta property="og:locale" content="en_US">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
{canonical && <meta property="og:url" content={canonical}>}
<meta property="og:image" content={shareImage}>
{isArticle && page && <meta property="article:author" content="Iris Holloway">}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={shareImage}>
{ld && <script type="application/ld+json" set:html={ld} />}
